<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMsgSensor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sensor"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvMsgTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00:00"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMsgSala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sala: 1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMsgLeitura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leitura: 0.0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMsgText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Conteúdo da mensagem..."
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvMsgTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Tipo: Crítico"
            android:textStyle="italic"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
